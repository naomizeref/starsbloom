
# ── Database + Storage (Supabase) ───────────────────────────────
# Project URL and ANON (public) key from Supabase → Project Settings → API.
# The anon key is designed for client use; access is enforced by RLS.
# NEVER put the Supabase service_role key here or anywhere client-side.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Runtime mode ────────────────────────────────────────────────
# Leave all three false for production. VITE_LOCAL_DEV=true and
# VITE_USE_MOCK_DATA=true are for local development only.
VITE_LOCAL_DEV=false
VITE_USE_MOCK_DATA=false
VITE_MAINTENANCE_MODE=false

# ── Server / API (server-side only — never bundled to the client) ─
# Supabase service_role key — FULL database access, BYPASSES all RLS.
# Used by markets, authenticated email delivery, and verification-code APIs.
# NEVER prefix with VITE_, never expose to the browser, never commit the value.
SUPABASE_SERVICE_ROLE_KEY=
# Optional server URL alias; /api/markets falls back to VITE_SUPABASE_URL.
SUPABASE_URL=
# Optional CoinGecko Demo API key (server only); needed if the provider requires it.
COINGECKO_DEMO_API_KEY=
PORT=5173
HMR_PORT=24680
DISABLE_HMR=false
# Transactional email (Resend). RESEND_FROM_EMAIL must be a sender on a
# VERIFIED domain (Resend Dashboard → Domains). The sandbox sender
# "onboarding@resend.dev" only delivers to your own Resend account email —
# every other recipient is rejected, so signups/notifications silently never
# arrive (see MIGRATION_NOTES.md bugs #15/#16).
RESEND_API_KEY=
RESEND_FROM_EMAIL="Bloom <noreply@your-verified-domain.com>"
# Optional AI features (Google Gemini), used by the /api/markets-adjacent tooling.
GEMINI_API_KEY=
# Branding used in transactional emails.
BLOOM_COMPANY_NAME=Bloom
BLOOM_SUPPORT_EMAIL=support@joinbloom.online
# Actual monitored inbox for replies and support-ticket notifications.
BLOOM_REPLY_TO_EMAIL=support@joinbloom.online
# Set to the real HTTPS production origin for email buttons.
BLOOM_SITE_URL=https://bloom-two-kappa.vercel.app
# Setup and release checks: docs/email-setup.md

# Local/legacy defaults only. For the migrated joinbloom.online Production site,
# set BOTH flags to clerk in the new Vercel project and rebuild. Environment
# variables do not transfer when a repository is imported into another project.
# See docs/starsbloom-auth-deployment.md and docs/clerk-auth-migration.md.
VITE_AUTH_PROVIDER=supabase
AUTH_PROVIDER=supabase
# Browser-safe key from the matching Clerk application.
VITE_CLERK_PUBLISHABLE_KEY=
# Server secrets/config. Never prefix the secret key with VITE_.
CLERK_SECRET_KEY=
# Exact HTTPS issuer from the Clerk Supabase integration (no trailing slash).
CLERK_JWT_ISSUER=
# Comma-separated exact origins; add localhost only in local development.
CLERK_AUTHORIZED_PARTIES=https://www.joinbloom.online,https://joinbloom.online
